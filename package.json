{
  "name": "uranium-strategy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:indexer": "node services/indexer/server.mjs",
    "verify:devnet": "node scripts/verify-devnet.mjs",
    "verify:devnet-gameplay": "node scripts/verify-devnet-gameplay.mjs",
    "verify:devnet-state": "node scripts/verify-devnet-state.mjs",
    "test:surfpool": "node scripts/test-surfpool-lifecycle.mjs",
    "prepare:mainnet": "node scripts/prepare-mainnet.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:indexer": "SOLANA_RPC_HTTP_URL=http://127.0.0.1 USR_PROGRAM_ID=4ZssVwZYsfPAdoWozYyxPHFYts5uohJBHWCQo6yEm5AC SUPABASE_URL=https://example.invalid SUPABASE_SERVICE_ROLE_KEY=self-test INDEXER_SELF_TEST=1 node services/indexer/server.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@solana-program/system": "^0.13.0",
    "@solana-program/token": "^0.15.0",
    "@solana/kit": "^7.0.0",
    "@solana/kit-plugin-rpc": "^0.13.0",
    "@solana/kit-plugin-wallet": "^0.13.1",
    "@solana/react": "^7.0.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
